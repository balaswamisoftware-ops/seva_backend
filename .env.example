NODE_ENV=development
PORT=4000

# Mongo (replica set required for transactions)
MONGODB_URI=mongodb://localhost:27017/seva_erp?replicaSet=rs0

# JWT
JWT_ACCESS_SECRET=change-this-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-this-refresh-secret-min-16-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# PIN login (HMAC pepper for deterministic PIN lookup). Change in production.
PIN_PEPPER=change-this-pin-pepper-to-a-long-random-string

CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
